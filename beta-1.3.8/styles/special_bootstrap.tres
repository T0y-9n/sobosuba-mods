[gd_resource type="Resource" load_steps=2 format=3]

[sub_resource type="GDScript" id="1"]
script/source = "extends Resource

func _init() -> void:
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null:
		return
	var node: Node = tree.root.get_node_or_null(\"SpecialSobo\")
	if node == null and Engine.has_meta(\"special_sobo_runtime\"):
		var reference: Variant = Engine.get_meta(\"special_sobo_runtime\")
		if reference is WeakRef:
			node = reference.get_ref()
	if is_instance_valid(node):
		if not node.has_method(\"register_base_traits\"):
			var diagnostics: Script = load(\"user://special_mod/special_diagnostics.gd\")
			diagnostics.write_line(diagnostics.MOD_VERSION, \"warning use the current separated packages together\")
			return
		if node.is_node_ready():
			node.register_base_traits()
		else:
			node.ready.connect(node.register_base_traits, CONNECT_ONE_SHOT)
		return
	var path := \"user://special_mod/special_sobo.gd\"
	var script := GDScript.new()
	script.source_code = FileAccess.get_file_as_string(path)
	script.take_over_path(path)
	if script.reload() != OK:
		return
	node = script.new()
	Engine.set_meta(\"special_sobo_runtime\", weakref(node))
	# Every mod joins one queue. The first one adds them all, in the order the
	# Sobosuba Mod Manager saved, once every bootstrap has run.
	var queue: Array = Engine.get_meta(\"sobosuba_mod_queue\", [])
	queue.append([\"special_sobo\", node])
	Engine.set_meta(\"sobosuba_mod_queue\", queue)
	if queue.size() > 1:
		return
	var add_queued := func() -> void:
		var waiting: Array = Engine.get_meta(\"sobosuba_mod_queue\", [])
		Engine.remove_meta(\"sobosuba_mod_queue\")
		var order: Array = []
		if FileAccess.file_exists(\"user://mod_load_order.json\"):
			var saved: Variant = JSON.parse_string(FileAccess.get_file_as_string(\"user://mod_load_order.json\"))
			if saved is Dictionary and saved.get(\"order\") is Array:
				order = saved.order
		var ranked: Array = []
		for index in waiting.size():
			var rank: int = order.find(waiting[index][0])
			ranked.append([rank if rank >= 0 else order.size(), index, waiting[index][1]])
		ranked.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0] or (a[0] == b[0] and a[1] < b[1]))
		var root: Window = (Engine.get_main_loop() as SceneTree).root
		for item: Array in ranked:
			root.add_child(item[2])
	add_queued.call_deferred()
"

[resource]
script = SubResource("1")
