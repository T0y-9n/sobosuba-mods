static func get_text(key: String) -> String:
	var words: Dictionary = WORDS.get(key, {})
	var locale: String = TranslationServer.get_locale()
	if words.has(locale):
		return words[locale]
	var language: String = locale.get_slice("_", 0)
	if language == "zh":
		var traditional: bool = locale.contains("TW") || locale.contains("HK") || locale.contains("MO") || locale.contains("Hant")
		return words["zh_TW"] if traditional else words["zh_CN"]
	return words.get(language, words.get("en", key))
